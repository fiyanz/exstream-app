# Database Configuration
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/database_name

# Shipping Cost API
SHIPPING_COST_API_KEY=your_shipping_api_key

# Komerce API Configuration
KOMERCE_API_KEY=your_komerce_api_key
KOMERCE_BASE_URL=https://api.komerce.com
KOMERCE_ORDER_BASE_URL=https://api.komerce.com/orders
MY_ORIGIN_DESTINATION_ID=your_origin_id

# Raja Ongkir API Configuration
RAJA_ONGKIR_BASE_URL=https://api.rajaongkir.com
RAJA_ONGKIR_DESTINATION_URL=https://api.rajaongkir.com/starter/city

# Midtrans Configuration (SANDBOX)
MIDTRANS_SERVER_KEY=SB-Mid-server-your_sandbox_server_key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_sandbox_client_key
MIDTRANS_IS_PRODUCTION=false

# Admin Configuration
ADMIN_WHATSAPP=628xxxxxxxxxx
